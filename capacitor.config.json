{
  "appId": "com.earnova.app",
  "appName": "EARNOVA",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0f172a",
    "loggingBehavior": "none"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "AdMob": {
      "appId": "ca-app-pub-1093580583332518~8050365428"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": true,
        "apple": false,
        "twitter": false
      }
    }
  }
}
